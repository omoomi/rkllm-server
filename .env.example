# Server
HOST=0.0.0.0
PORT=11434
LOG_LEVEL=info

# Model selection
# Available models:
# - Qwen3-4B-1.2.0 (4B, 4096 context, ~3-4 t/s)
# - Qwen3-1.7B (1.7B, 16384 context, ~6-8 t/s) - RECOMMENDED for tool calling
# - Qwen3-0.6B-w8a8-ctx16384 (0.6B, 16384 context, ~11-12 t/s) - Fastest
# - Llama-3.2-3B-Instruct_w8a8_ctx16384_RK3588 (3B, 16384 context, ~5-7 t/s) - Good tool calling, slow
# - Llama-3.2-1B-Instruct_w8a8_ctx16384_RK3588 (1B, 16384 context, ~8-10 t/s) - Fastest, poor tool calling
MODEL_NAME=Qwen3-1.7B

# Model configuration (optional - overrides model defaults)
MAX_CONTEXT_LEN=16384       # Maximum context window in tokens (1-16384)
MAX_NEW_TOKENS=2048         # Maximum tokens to generate (1-2048)
TEMPERATURE=0.8               # Sampling temperature (0.0-2.0, higher = more random)
TOP_P=0.9                    # Nucleus sampling parameter (0.0-1.0, controls diversity)
TOP_K=1                        # Top-K sampling (>= 1, higher = less diverse)
REPEAT_PENALTY=1.1          # Penalize repetition (>= 1.0, higher = less repetition)

# Performance (balanced)
CPU_CORES=AUTO                # CPU cores: AUTO (recommended), range (4-7), or list (4,5,6,7)
ENABLE_EMBED_FLASH=1          # Enable flash attention (0/1, improves performance)
